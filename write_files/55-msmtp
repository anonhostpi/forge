#!/usr/bin/env bash
# see anonhostpi/forge#9
# phase: boot
# Host critical-mail transport. sendmail -> msmtpq (queue wrapper) so a mail to a DOWN Proton Bridge (U10) SPOOLS
# instead of being lost (plain msmtp has no retry — review F1); a timer flushes the spool once the Bridge is up.
# Relay is LOCAL (127.0.0.1) so NO Proton/external SMTP credential ever lands on the host.
set -euo pipefail
systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true   # free the dpkg lock (like 60-upgrades); timers re-arm on reboot
apt-get -o DPkg::Lock::Timeout=300 update -q
apt-get -o DPkg::Lock::Timeout=300 install -y -q msmtp
# noble ships the queue scripts at /usr/libexec/msmtp/msmtpq/, NOT /usr/bin — and msmtp-queue calls `msmtpq` by PATH.
# Symlink both into /usr/bin so the sendmail wrapper AND the flush service resolve them (review F1/F2 — else every mail is LOST).
ln -sf /usr/libexec/msmtp/msmtpq/msmtpq /usr/bin/msmtpq
ln -sf /usr/libexec/msmtp/msmtpq/msmtp-queue /usr/bin/msmtp-queue

# non-secret recipient + Bridge coords from config (the U8<->U10 contract)
operator="$(python3 -c 'import yaml; print(yaml.safe_load(open("config/seed.yaml"))["mail"]["to"])')"
port="$(python3 -c 'import yaml; print(yaml.safe_load(open("config/seed.yaml"))["mail"]["bridge_smtp_port"])')"
bridge_user="$(python3 -c 'import yaml; print(yaml.safe_load(open("config/seed.yaml"))["mail"]["bridge_user"])')"
starttls="$(python3 -c 'import yaml; print(str(yaml.safe_load(open("config/seed.yaml"))["mail"]["bridge_starttls"]).lower())')"

# The Bridge's LOOPBACK TLS mode is VERSION-DEPENDENT — 3.19.0-1 listens plaintext, other builds offer STARTTLS. Driven
# by the seed.yaml knob, never guessed (forge#11 review F2; the earlier hardcoded `tls on` was asserted, not verified).
if [ "$starttls" = true ]; then
  tls_block=$'tls on\ntls_starttls on\ntls_certcheck off'
else
  tls_block=$'tls off'
fi

# `auth on` alone is insufficient: msmtp's auto-negotiate errors "cannot use a secure authentication method" against the
# Bridge, so pin `auth login`. The password is the Bridge's LOCAL, self-generated credential — never the Proton ACCOUNT
# password — and it is read via `passwordeval` from a 0600 root file the operator writes at the one-time interactive
# init, so no cleartext secret sits in /etc/msmtprc. Until that file exists msmtp fails to send and msmtpq QUEUES the
# mail rather than losing it — exactly what U8's queue is for. root:root 0600 (there is no `msmtp` group).
#
# `from` MUST be the authenticated Proton address: the Bridge rejects a MAIL FROM the logged-in account does not own,
# and msmtp defaults to `auto_from off` so this value IS the envelope sender. The old `from seed@$(hostname)` would
# have been rejected on every send — silently, since CI has no live login (review F1). `set_from_header on` keeps a
# system mailer's `root@seed` header from re-introducing the mismatch.
#
# UNVERIFIED (review F2): that msmtp performs cleartext LOGIN over `tls off` on this build. It is the documented
# msmtp+Bridge pattern and fails SAFE (msmtpq queues, never loses), but it is not proven here — if the first real send
# errors on auth, flip `mail.bridge_starttls` and re-run. Do not treat this comment as verification.
cat > /etc/msmtprc <<CONF
defaults
logfile /var/log/msmtp.log
aliases /etc/aliases

account bridge
host 127.0.0.1
port ${port}
${tls_block}
auth login
user ${bridge_user}
passwordeval "cat /etc/msmtp-bridge.pass"
from ${bridge_user}
set_from_header on

account default : bridge
CONF
chmod 0600 /etc/msmtprc
chown root:root /etc/msmtprc

# bare `root` / fail2ban mail -> the operator, else Proton can't deliver a domainless recipient (review F2)
cat > /etc/aliases <<ALIASES
root: ${operator}
default: ${operator}
ALIASES

# System spool + the msmtpq queue wrapper as the sendmail alternative (review F1).
install -d -m 0700 /var/spool/msmtpq
cat > /etc/msmtpq.conf <<'CONF'
MSMTPQ_Q=/var/spool/msmtpq
MSMTPQ_LOG=/var/log/msmtpq.log
CONF
cat > /usr/local/sbin/forge-sendmail <<'WRAP'
#!/bin/sh
# see anonhostpi/forge#9 — a mail to a down Bridge spools here instead of being lost
set -a; . /etc/msmtpq.conf; set +a
exec /usr/bin/msmtpq "$@"
WRAP
chmod 0755 /usr/local/sbin/forge-sendmail
update-alternatives --install /usr/sbin/sendmail sendmail /usr/local/sbin/forge-sendmail 40

# Flush the spool on boot + every 5 min — delivers queued critical mail once the Bridge (U10) is up.
cat > /etc/systemd/system/msmtpq-flush.service <<'UNIT'
[Unit]
Description=Flush the msmtp mail queue
[Service]
Type=oneshot
EnvironmentFile=/etc/msmtpq.conf
ExecStart=/usr/bin/msmtp-queue -r
UNIT
cat > /etc/systemd/system/msmtpq-flush.timer <<'UNIT'
[Unit]
Description=Periodic msmtp queue flush
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now msmtpq-flush.timer

msmtp --version >/dev/null
echo "55-msmtp applied (sendmail -> msmtpq queue -> Bridge 127.0.0.1:${port}; flush timer active; root -> ${operator})"
