#!/usr/bin/env bash
# see anonhostpi/forge#8
# phase: boot
set -euo pipefail
apt-get -o DPkg::Lock::Timeout=300 update -q
apt-get -o DPkg::Lock::Timeout=300 install -y -q fail2ban
# backend=systemd: 24.04 minimal has no rsyslog/auth.log, so the file backend would watch nothing (review F1).
# key-only sshd (U6) means "Failed password" never fires; aggressive catches preauth probes. key-auth SUCCESS is
# not a jail event, so U4's repeated deploy SSH is immune; generous findtime/maxretry so dirty-replay churn won't trip (F5,F7).
cat > /etc/fail2ban/jail.local <<'CONF'
[DEFAULT]
backend = systemd
findtime = 600
maxretry = 6
bantime  = 3600

[sshd]
enabled = true
mode    = aggressive
port    = 22
CONF
systemctl enable --now fail2ban
fail2ban-client ping >/dev/null       # self-verify the daemon answers
echo "70-fail2ban applied (systemd backend, sshd jail watching the journal)"
