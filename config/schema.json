{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "see anonhostpi/forge#2 — the contract U3/U4/U6/U9/U13/U14 render against",
  "$defs": {
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "k3s", "postgres", "images", "charts", "mail", "firewall"],
      "properties": {
        "hostname": {"type": "string"},
        "k3s": {"type": "object", "required": ["channel", "version"]},
        "postgres": {"type": "object", "required": ["host", "port", "name", "user"]},
        "images": {"type": "object", "required": ["proton_bridge"]},
        "charts": {"type": "object", "required": ["forgejo"]},
        "mail": {"type": "object", "required": ["to", "bridge_smtp_port", "bridge_user", "bridge_starttls"], "properties": {"bridge_starttls": {"type": "boolean"}}},
        "firewall": {"type": "object", "required": ["allowed_input_ports", "pod_cidr", "service_cidr", "drop_metadata"], "properties": {"allowed_input_ports": {"type": "array", "minItems": 1, "items": {"type": "integer"}}}}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh", "fail2ban", "network"],
      "properties": {
        "ssh": {"type": "object", "required": ["admin_port", "git_port"]},
        "fail2ban": {"type": "object", "required": ["bantime", "findtime", "maxretry"]},
        "network": {"type": "object", "required": ["fqdn_scheme"]}
      }
    },
    "secrets": {
      "$comment": "no additionalProperties:false — a SOPS-decrypted file retains a top-level `sops:` metadata key",
      "type": "object",
      "$comment2": "forge#11 — `proton` is NOT required: the Bridge GENERATES its local username/bridge_password at interactive init and stores them in its own volume. Nothing decrypts or delivers them (the box cannot decrypt SOPS; deploy pushes only k8s manifests), so a required `proton` block was a dead secret. Kept optional as operator reference.",
      "required": ["deploy_ssh", "forgejo", "postgres", "k3s"],
      "properties": {
        "deploy_ssh": {"type": "object", "required": ["scope", "private", "user"]},
        "forgejo": {"type": "object", "required": ["scope", "admin_user", "admin_email", "admin_password", "secret_key", "internal_token", "ssh_host_key", "mailer_from", "mailer_password"]},
        "postgres": {"type": "object", "required": ["scope", "app_password", "superuser_password"]},
        "proton": {"type": "object", "required": ["scope", "username", "bridge_password"]},
        "k3s": {"type": "object", "required": ["scope", "token"]}
      }
    }
  }
}
